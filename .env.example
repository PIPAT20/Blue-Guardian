# ==============================================================================
# MICROPLASTIC MONITORING & ALERT PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TIMEZONE=Asia/Bangkok

# Demo / Simulation Mode (true = allows embedded 2-year simulation and simulator controls)
NEXT_PUBLIC_DEMO_MODE=true

# Database Configuration (Supabase PostgreSQL / Direct Postgres Connection)
DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# IoT Ingestion Security
INGEST_API_KEY_SECRET="sec_iot_ingest_master_key_998124"
ESP32_DEFAULT_DEVICE_KEY="dev_key_mp001_secret"

# Notification Channels: Telegram Bot (Dev Primary)
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_CHAT_ID="your-telegram-chat-id"

# Notification Channels: LINE Official Account (Messaging API - Flex Message)
LINE_CHANNEL_ACCESS_TOKEN="your-line-messaging-api-channel-access-token"
LINE_CHANNEL_SECRET="your-line-channel-secret"
LINE_MONTHLY_FREE_QUOTA=500

# Notification Channels: Firebase Cloud Messaging (FCM Mobile App)
FCM_PROJECT_ID="microplastic-platform-iot"
FCM_CLIENT_EMAIL="firebase-adminsdk@microplastic-platform-iot.iam.gserviceaccount.com"
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Notification Channels: Fallback SMTP / Email
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="smtp-username"
SMTP_PASS="smtp-password"
ALERT_EMAIL_FROM="alerts@microplastic-platform.io"
ALERT_EMAIL_TO="operator-team@microplastic-platform.io"

# Analytics Default Thresholds (Fallback when not configured in DB)
DEFAULT_FULLNESS_WARNING_PCT=70
DEFAULT_FULLNESS_HIGHRISK_PCT=85
DEFAULT_FULLNESS_CRITICAL_PCT=95
DEFAULT_SENSOR_DISAGREEMENT_PCT=25
DEFAULT_FLOW_LEAKAGE_PCT=10
DEFAULT_MIN_DELTA_TON=0.2
DEFAULT_COOLDOWN_MINUTES=60
